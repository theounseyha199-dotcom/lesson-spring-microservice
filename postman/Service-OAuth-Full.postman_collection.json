{
  "info": {
    "name": "Service OAuth Test - Full Local API (Ready to Import)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Import the accompanying Local environment and select it. Set order_client_secret to the auth server ORDER_CLIENT_SECRET. Run both token requests, create a customer and business, then test orders. Tokens and created IDs are saved automatically. Folder 08 is manual only. Order POST/PUT endpoints currently have CSRF enabled and may return 403 even with a valid bearer token; this collection does not change server security. Collection defaults are included; select No environment to avoid stale overrides. Set order_client_secret in collection Variables. Token and ID scripts save collection variables."
  },
  "item": [
    {
      "name": "01 - OAuth tokens and metadata",
      "description": "",
      "item": [
        {
          "name": "OpenID discovery",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{auth_url}}/.well-known/openid-configuration",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "OAuth metadata",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{auth_url}}/.well-known/oauth-authorization-server",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Signing public keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{auth_url}}/oauth2/jwks",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order API token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{auth_url}}/oauth2/token",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{client_id}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{client_secret}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "api.read api.write",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token issued\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const data = pm.response.json(); pm.test(\"Access token present\", () => pm.expect(data.access_token).to.be.a(\"string\").and.not.empty); pm.collectionVariables.set(\"access_token\", data.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get direct customer API token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{auth_url}}/oauth2/token",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{order_client_id}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{order_client_secret}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "customer.read customer.write",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token issued\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const data = pm.response.json(); pm.test(\"Access token present\", () => pm.expect(data.access_token).to.be.a(\"string\").and.not.empty); pm.collectionVariables.set(\"customer_access_token\", data.access_token); }"
                ]
              }
            }
          ]
        }
      ]
    },
